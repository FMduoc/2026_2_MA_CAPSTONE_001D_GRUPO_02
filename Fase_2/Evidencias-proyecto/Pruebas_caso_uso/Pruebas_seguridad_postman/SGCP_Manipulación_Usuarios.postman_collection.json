    {
      "name": "Verificación",
      "item": [
        {
          "name": "Verifying changes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const lista = pm.response.json();\r\nconst objetivo = lista.find(u => u.id == pm.collectionVariables.get('id_objetivo'));\r\nconst solicitante = lista.find(u => u.id == pm.collectionVariables.get('id_solicitante'));\r\n\r\npm.test('El rol del usuario objetivo no cambió', () =>\r\n  pm.expect(objetivo.rol).to.eql(pm.collectionVariables.get('rol_objetivo_antes')));\r\npm.test('El solicitante sigue siendo solicitante', () =>\r\n  pm.expect(solicitante.rol).to.eql('solicitante'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
